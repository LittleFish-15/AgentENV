+            pool.compute_maintenance_action(1000),
+            PoolMaintenanceAction::Idle
+        );
+        for value in 0..1000 {
+            pool.try_push_bounded(value).unwrap();
+        }
+        for _ in 0..202 {
+            assert!(pool.try_acquire().is_some());
+        }
+        assert_eq!(pool.len(), 798);
+        assert_eq!(
+            pool.compute_maintenance_action(pool.len()),
+            PoolMaintenanceAction::Idle
+        );
+        assert_eq!(pool.current_fill_target(), 300);
+        // Acquisition pressure below low still uses the original growth policy.
+        for _ in 0..499 {
+            assert!(pool.try_acquire().is_some());
+        }
+        assert_eq!(pool.len(), 299);
+        assert_eq!(pool.current_fill_target(), 600);
+        assert_eq!(
+            pool.compute_maintenance_action(pool.len()),
+            PoolMaintenanceAction::Fill(301)
+        );
