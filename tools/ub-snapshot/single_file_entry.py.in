"""Single-file UB bridge/broker smoke delivery. No ZIP, downloads or service changes.

Copy this one file to /home/jwk/agent on original server1 and agent1.
A: python3 -I -B ub_layer_once.py owner node-a
B: run the complete peer command printed by A. After B exits, type done on A.
"""
import argparse
import importlib.util
import os
from pathlib import Path
import socket
import stat
import sys

ROOT = Path('/home/jwk/agent')
REVISION = 'ub-layer-single-v1'
SOURCE_COMMIT = '@SOURCE_COMMIT@'
PAYLOADS = @PAYLOADS@


def checked(path, root=None):
    root = ROOT if root is None else root
    path = Path(path).absolute()
    if not path.is_relative_to(root) or path.resolve() != path:
        raise ValueError('Paths must stay below /home/jwk/agent without redirection')
    return path


def preflight(args):
    if (sys.platform != 'linux' or os.getuid() != 1204 or os.geteuid() != 1204
            or os.getgid() != 1205 or os.getegid() != 1205):
        raise ValueError('Use original ordinary jwk UID1204/GID1205, never root')
    expected = 'agent1' if args.role == 'peer' else 'server1'
    if socket.gethostname() != expected or args.node != ('node-b' if args.role == 'peer' else 'node-a'):
        raise ValueError('owner/cleanup on server1 node-a; peer on agent1 node-b')
    caps = [line.split(':')[1].strip() for line in Path('/proc/self/status').read_text().splitlines()
            if line.startswith(('CapInh:', 'CapPrm:', 'CapEff:', 'CapAmb:'))]
    if len(caps) != 4 or any(int(value, 16) for value in caps):
        raise ValueError('Standalone smoke requires zero capabilities')
    entry = checked(Path(__file__).absolute())
    if entry.parent != ROOT:
        raise ValueError('Place this one script directly in /home/jwk/agent')
    checked(ROOT / 'relay')
    checked(ROOT / 'relay/reports')
    if not (ROOT / 'relay/reports').is_dir():
        raise ValueError('Existing experiment report directory is missing')
    if args.role == 'owner' and not sys.stdin.isatty():
        raise ValueError('Keep an interactive owner terminal open until B completely exits')


def regular_owned(fd, uid):
    metadata = os.fstat(fd)
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != uid or metadata.st_nlink != 1:
        raise ValueError('Unexpected embedded-source file identity; preserve it')


def prepare_payloads(directory, uid):
    directory = checked(directory)
    directory.mkdir(mode=0o700 if os.name == 'posix' else 0o755, exist_ok=True)
    if not directory.is_dir() or directory.stat().st_uid != uid:
        raise ValueError('Unexpected embedded-source directory identity')
    if any(path.name not in {*PAYLOADS, 'prepare.lock'} for path in directory.iterdir()):
        raise ValueError('Unexpected files in embedded-source directory; preserve it')
    for name, text in PAYLOADS.items():
        target = checked(directory / name)
        encoded = text.encode('utf-8')
        try:
            fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, 'O_NOFOLLOW', 0), 0o600)
        except FileExistsError:
            fd = os.open(target, os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0) | getattr(os, 'O_NONBLOCK', 0))
            with os.fdopen(fd, 'rb') as stream:
                regular_owned(stream.fileno(), uid)
                raw = stream.read(len(encoded) + 4097)
            # Text transfer may introduce BOM/CRLF. Do not rewrite an existing file.
            if raw.decode('utf-8-sig').replace('\r\n', '\n') != text:
                raise ValueError('Embedded source differs: ' + name + '; no overwrite or SDK calls')
        else:
            with os.fdopen(fd, 'wb') as stream:
                regular_owned(stream.fileno(), uid)
                stream.write(encoded)
                stream.flush()
                os.fsync(stream.fileno())
    return directory / 'sdk_smoke.py'


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('role', choices=['owner', 'peer', 'cleanup'])
    parser.add_argument('node', choices=['node-a', 'node-b'])
    parser.add_argument('--replica-token')
    parser.add_argument('--peer-stopped', action='store_true')
    parser.add_argument('--format', choices=['raw', 'tar', 'zfile'])
    parser.add_argument('--probe')
    args = parser.parse_args()
    preflight(args)
    import fcntl
    os.umask(0o077)
    sys.dont_write_bytecode = True
    for name in ('ub_layer_broker.py', 'sdk_smoke.py'):
        compile(PAYLOADS[name], name, 'exec')
    directory = checked(ROOT / 'relay' / REVISION)
    directory.mkdir(mode=0o700, exist_ok=True)
    lock = os.open(checked(directory / 'prepare.lock'),
                   os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        regular_owned(lock, 1204)
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        print('PHASE=prepare_single_file_sources revision=' + REVISION, flush=True)
        source = prepare_payloads(directory, 1204)
    finally:
        os.close(lock)
    print('SOURCE_COMMIT=' + SOURCE_COMMIT, flush=True)
    spec = importlib.util.spec_from_file_location('aenv_ub_single_smoke', source)
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    # Preserve sys.argv[0]: B must run this same single file, preparing its own
    # embedded sources, rather than depend on A's generated helper path.
    return module.main()


if __name__ == '__main__':
    try:
        result = main()
    except Exception as error:
        import json
        print('BEGIN_RETURN_REPORT')
        print(json.dumps({'status': 'STOPPED_SINGLE_FILE_ENTRY_PRESERVE_RECEIPTS',
                          'error': type(error).__name__ + ': ' + str(error),
                          'revision': REVISION, 'SDK_state': 'not inferred from an entrypoint error'}, indent=2))
        print('END_RETURN_REPORT')
        result = 1
    raise SystemExit(result)
